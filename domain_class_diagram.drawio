        <!-- Class: SuperAdminUser -->
        <mxCell id="c_admin" value="&lt;p style=&quot;margin:0px;padding-top:4px;text-align:center;&quot;&gt;&lt;b&gt;SuperAdminUser&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left;&quot;&gt;+ username: String [PK]&lt;br/&gt;+ role: String = &amp;quot;SuperAdmin&amp;quot;&lt;br/&gt;+ password_hash: String&lt;br/&gt;+ mfa_enabled: Boolean&lt;br/&gt;+ mfa_secret: String&lt;br/&gt;+ passkey_credentials: List&amp;lt;JSON&amp;gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left;&quot;&gt;+ verifyPasskeySignature(): Boolean&lt;br/&gt;+ authenticateTOTP(token): Boolean&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=1.5;fontColor=#581C87;rounded=0;" vertex="1" parent="pkg_control">
          <mxGeometry x="40" y="46" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- Class: TenantRegistry -->
