        <mxCell id="hdr" parent="1" style="rounded=0;strokeColor=none;fillColor=#232F3E;align=left;spacingLeft=20;fontColor=#ffffff;fontSize=15;fontFamily=Helvetica;fontStyle=1;" value="STORIX CLOUD — TENANT LIFECYCLE STATE MACHINE" vertex="1">
          <mxGeometry height="42" width="1040" x="20" y="15" as="geometry" />
        </mxCell>

        <!-- Initial State [*] -->
        <mxCell id="st-init" parent="1" style="ellipse;fillColor=#0F172A;strokeColor=none;" vertex="1">
          <mxGeometry height="28" width="28" x="50" y="180" as="geometry" />
        </mxCell>

        <!-- State 1: PROVISIONING -->
        <mxCell id="st-prov" parent="1" style="rounded=1;strokeColor=#E7157B;strokeWidth=2;fillColor=#E7157B;fillOpacity=10;fontFamily=Helvetica;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#831843;" value="PROVISIONING&#xa;&lt;font style='font-size:10px;font-weight:normal;color:#475569;'&gt;Step Functions SAGA Micro-Workflow&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="190" x="140" y="164" as="geometry" />
        </mxCell>

        <!-- State 2: ACTIVE -->
