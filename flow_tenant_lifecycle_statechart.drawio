          <mxGeometry height="65" width="210" x="430" y="161" as="geometry" />
        </mxCell>

        <!-- State 3: SUSPENDED -->
        <mxCell id="st-susp" parent="1" style="rounded=1;strokeColor=#F59E0B;strokeWidth=2;fillColor=#F59E0B;fillOpacity=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#92400E;" value="SUSPENDED (HIBERNATION)&#xa;&lt;font style='font-size:10px;font-weight:normal;color:#78350F;'&gt;desiredCount: 0 · $0.00 Compute Idle&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="220" x="740" y="161" as="geometry" />
        </mxCell>

        <!-- State 4: ROLLING_UPDATE -->
